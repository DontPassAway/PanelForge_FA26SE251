{
  "Database": {
    "Target": "Local"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres-staging;Port=5432;Database=panelforge_staging;Username=postgres;Password=YOUR_STAGING_DB_PASSWORD"
  },
  "JwtSettings": {
    "Secret": "YOUR_STAGING_JWT_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "PanelForgeStaging",
    "Audience": "PanelForgeStagingClient",
    "ExpiryMinutes": 60
  },
  "Firebase": {
    "ProjectId": "YOUR_FIREBASE_PROJECT_ID",
    "ServiceAccountKeyPath": "firebase-key.json"
  },
  "GooglePlay": {
    "ServiceAccountKeyPath": "google-play-key.json"
  },
  "EmailConfiguration": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "PanelForge Staging",
    "SenderEmail": "YOUR_SENDER_EMAIL",
    "Password": "YOUR_SMTP_APP_PASSWORD"
  },
  "AssetStorage": {
    "Provider": "Local",
    "RootPath": "",
    "R2": {
      "AccountId": "",
      "Bucket": "panelforge-staging-assets",
      "AccessKeyId": "",
      "SecretAccessKey": ""
    }
  },
  "AiService": {
    "GeminiModel": "gemini-3.8-flash",
    "ServiceUrl": "http://ai-service-staging:5055",
    "MaxRevisionRounds": 2,
    "RunStaleAfterSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "TranslationService": {
    "BaseUrl": "http://translation-staging:5000"
  },
  "SePay": {
    "WebhookApiKey": ""
  },
  "AllowedHosts": "*"
}
