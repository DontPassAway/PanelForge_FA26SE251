<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>panelforge-ai-9b2d5a10</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PanelForge.AI.Contracts\PanelForge.AI.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework (MIT): ChatClientAgent trên IChatClient. Bản 1.x có target net8.0 → chạy trên net9.0. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.23.0" />
    <!-- Cầu nối IChatClient → endpoint OpenAI-compatible của Gemini (không thêm Semantic Kernel). -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <!-- Retry + circuit breaker + timeout cho gọi HTTP sang Backend (và Polly cho LlmGateway). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\*.md" />
  </ItemGroup>

</Project>