// PanelForge Core Production Architecture - Prisma Schema
// Relational Database Specification (PostgreSQL)
// Strictly enforces: Series (Parent Workspace & Bible) -> Chapter (Production Container) -> Script (Dedicated Chapter Document)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enum Definitions
// -----------------------------------------------------------------------------

enum ChapterStatus {
  PLANNING
  SCRIPTING
  IN_REVIEW
  APPROVED
  STORYBOARDING
  DRAWING
  PUBLISHED
}

enum RoleInProject {
  PRODUCER
  WRITER
  ARTIST
  EDITOR
}

// -----------------------------------------------------------------------------
// 1. Series Level (Studio IP & Bible)
// -----------------------------------------------------------------------------

model Series {
  id           String             @id @default(uuid())
  title        String
  description  String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  
  // Relations
  bible        SeriesBible?
  chapters     Chapter[]
  members      ProjectMember[]

  @@map("series")
}

model SeriesBible {
  id           String             @id @default(uuid())
  seriesId     String             @unique
  series       Series             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  logline      String?
  synopsis     String?            @db.Text
  worldSetting String?            @db.Text
  characters   CharacterProfile[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("series_bibles")
}

model CharacterProfile {
  id           String             @id @default(uuid())
  bibleId      String
  bible        SeriesBible        @relation(fields: [bibleId], references: [id], onDelete: Cascade)
  name         String
  role         String?            // Protagonist, Antagonist, Supporting
  bio          String?            @db.Text
  avatarUrl    String?
  colorTag     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("character_profiles")
}

// -----------------------------------------------------------------------------
// 2. Project Membership & Permissions
// -----------------------------------------------------------------------------

model ProjectMember {
  id           String             @id @default(uuid())
  seriesId     String
  series       Series             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId       String
  role         RoleInProject
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([seriesId, userId])
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// 3. Chapter Container (Producer Managed)
// -----------------------------------------------------------------------------

model Chapter {
  id             String          @id @default(uuid())
  seriesId       String
  series         Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapterNumber  Int
  title          String?
  status         ChapterStatus   @default(PLANNING)
  deadline       DateTime?
  targetPanels   Int             @default(60)
  
  // Assignees
  producerId     String
  writerId       String?
  artistId       String?
  
  // The Script belongs strictly to this Chapter (1 Chapter : 1 Script)
  script         ChapterScript?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([seriesId, chapterNumber])
  @@index([seriesId, status])
  @@map("chapters")
}

// -----------------------------------------------------------------------------
// 4. Chapter Script Artifact & Structured AST
// -----------------------------------------------------------------------------

model ChapterScript {
  id           String        @id @default(uuid())
  chapterId    String        @unique
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  version      Int           @default(1)
  rawText      String        @db.Text
  isLocked     Boolean       @default(false)
  lockedAt     DateTime?
  lockedById   String?
  
  // Structured AST Nodes
  scenes       Scene[]
  pages        Page[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("chapter_scripts")
}

model Scene {
  id           String        @id @default(uuid())
  scriptId     String
  script       ChapterScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  slugline     String        // e.g. "EXT. SHIBUYA CROSSING - NIGHT (RAIN)"
  orderIndex   Int
  isFlashback  Boolean       @default(false)
  panels       Panel[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([scriptId, orderIndex])
  @@map("scenes")
}

model Page {
  id           String        @id @default(uuid())
  scriptId     String
  script       ChapterScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  pageNumber   Int
  orderRank    String        // Fractional indexing string (LexoRank)
  panels       Panel[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([scriptId, pageNumber])
  @@index([scriptId, orderRank])
  @@map("pages")
}

model Panel {
  id           String        @id @default(uuid())
  pageId       String
  page         Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sceneId      String        // Independent Scene binding (allows intra-page scene transition)
  scene        Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  panelNumber  Int
  cameraShot   String?
  actionText   String        @db.Text
  isFlashback  Boolean       @default(false)
  dialogues    Json?         // Array of { character: string, modifier?: string, text: string }
  sfx          Json?         // Array of { text: string }
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([pageId, panelNumber])
  @@index([sceneId])
  @@map("panels")
}
