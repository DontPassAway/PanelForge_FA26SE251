@startuml architecture
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
left to right direction
skinparam componentStyle rectangle
actor "Studio member" as member
actor "Reader / External reviewer" as reader
node "Web client" {
  [React 19 SPA\nVite 6, TypeScript, Konva] as FE
}
node "PanelForge Backend (.NET 9)" {
  [PanelForge.API\nREST, JWT, RequireWorkspaceRole] as API
  [PanelForge.Application\nCQRS handlers (MediatR)] as APP
  [PanelForge.Domain\nentities, invariants] as DOM
  [PanelForge.Infrastructure\nEF Core, Marten, clients] as INF
}
node "AI service (.NET 9)" {
  [PanelForge.AI\nMicrosoft Agent Framework] as AI
}
node "Image service (Python)" {
  [PanelForge.PanelSplitter\nFastAPI + OpenCV] as PS
}
database "PostgreSQL 17\ntables + Marten events" as DB
cloud "Cloudflare R2" as R2
cloud "Google Gemini\ngemini-2.5-flash" as GEM
cloud "Firebase Auth" as FB
cloud "SMTP email" as SMTP
member --> FE
reader --> API : catalog, watermarked preview
FE --> API : HTTPS JSON, cookie JWT
API --> APP
APP --> DOM
INF ..|> APP : implements interfaces
INF --> DB
INF --> R2 : signed URLs
INF --> FB : verify ID token
INF --> SMTP
INF --> AI : run workflow
AI --> API : read context, record steps
AI --> GEM
INF --> PS : split page into panels
@enduml
