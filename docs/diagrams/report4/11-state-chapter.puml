@startuml state_chapter
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
[*] --> InProduction : CreateChapter
state InProduction {
  [*] --> ScriptOpen
  ScriptOpen --> ScriptFrozen : FreezeScript (Producer)
  ScriptFrozen --> ScriptOpen : UnfreezeScript (Producer)\n[Planned v1.3: on Writer request]
}
InProduction --> Approved : ApproveChapter\n(Producer, all work approved)
Approved --> InProduction : ReopenChapter\n(Producer / Publisher, reason)
Approved --> Published : PublishChapter\n(Publisher, release date)
Published --> [*]
state Locked #EEEEEE : declared, never assigned (gap G6)
@enduml
