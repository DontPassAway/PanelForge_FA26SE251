@startuml seq_request_changes
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
actor Editor as E
actor Artist as A
participant AssignmentsController as C
participant Handlers as H
database PanelForgeDbContext as DB
E -> C : POST assignments/{id}/request-changes\n(region, comment)
C -> H : RequestAssignmentChangesCommand
H -> DB : Submission Rejected, ChangeRequest Open,\nAssignment ReworkRequired
H --> E : 200 OK
A -> C : POST change-requests/{id}/resolve
C -> H : ResolveChangeRequestCommand
H -> DB : ChangeRequest Resolved
A -> C : POST assignments/{id}/submit
E -> C : POST change-requests/{id}/verify
C -> H : VerifyChangeRequestCommand
H -> DB : ChangeRequest Verified
@enduml
