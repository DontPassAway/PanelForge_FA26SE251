@startuml wf02_production
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
|Producer|
start
:Freeze chapter script;
:Create assignments per Chapter, Page or Panel\nand stage (deadline, dependencies);
|Artist|
repeat
  if (Prior stage of this panel approved? (BR-19)) then (no)
    :Wait - dependency not met;
    detach
  endif
  :Start work;
  :Upload artwork for the stage;
  :Submit (Submission bound to chapter version\nand script revisions);
  |Editor|
  :Open review;
  if (Quality OK?) then (yes)
    :Approve stage\n(StageProgress Approved);
  else (no)
    :Request changes on a region;
    |Artist|
    :Fix and resubmit;
    |Editor|
    :Approve stage;
  endif
  |Artist|
repeat while (More stages before Letter?) is (yes) not (no)
|Letterer|
:Place balloons bound to script lines;
:Submit lettering;
|Editor|
:Approve Letter stage;
stop
@enduml
