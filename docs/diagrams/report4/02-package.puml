@startuml package
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
package "PanelForge.API" as API {
  [Controllers]
  [Authorization]
  [Middleware]
}
package "PanelForge.Application" as APP {
  [Features]
  [Common/Interfaces]
  [Behaviors]
}
package "PanelForge.Domain" as DOM {
  [Entities]
  [Enums]
  [Events]
}
package "PanelForge.Infrastructure" as INF {
  [Persistence]
  [Authentication]
  [ExternalServices]
  [Services]
  [Exports]
}
package "PanelForge.AI.Contracts" as AIC {
  [Shared DTOs]
}
package "PanelForge.AI" as AI {
  [Agents]
  [Workflows]
  [Gateway]
  [Prompts]
}
API ..> APP
API ..> INF
INF ..> APP
INF ..> DOM
APP ..> DOM
APP ..> AIC
AI ..> AIC
@enduml
