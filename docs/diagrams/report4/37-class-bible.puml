@startuml class_bible
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
class BibleController
class AddBibleEntryRevisionCommandHandler
class ReviewBibleEntryRevisionCommandHandler
class LockBibleEntryRevisionCommandHandler
class ConsistencyChecker {
  CHARACTER_AFTER_DEATH
  PROP_NOT_BEFORE
  KNOWLEDGE_BEFORE_REVEAL
  ENTRY_NOT_YET_EFFECTIVE
  CHARACTER_NOT_LOCKED
}
class SeriesBible
class BibleEntry {
  +Category : BibleEntryCategory
}
class BibleEntryRevision {
  +ReviewStatus : BibleRevisionStatus
  +DetailsJson : string
  +Endorse(reviewer)
  +RequestRework(reviewer, feedback)
  +Lock(user)
}
class ConsistencyFinding {
  +Severity : ConsistencyFindingSeverity
  +Status : ConsistencyFindingStatus
}
BibleController ..> AddBibleEntryRevisionCommandHandler
BibleController ..> ReviewBibleEntryRevisionCommandHandler
BibleController ..> LockBibleEntryRevisionCommandHandler
SeriesBible "1" *-- "*" BibleEntry
BibleEntry "1" *-- "*" BibleEntryRevision
ConsistencyChecker ..> BibleEntryRevision : reads metadata
ConsistencyChecker ..> ConsistencyFinding : creates
@enduml
