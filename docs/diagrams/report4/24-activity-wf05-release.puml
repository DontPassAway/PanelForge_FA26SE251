@startuml wf05_release
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
|Producer|
start
:All pages and panels approved;
:Approve chapter;
|Publisher|
if (Ready to release?) then (yes)
  :Publish with release date;
  |Reader|
  :Browse catalog;
  :Read published chapter;
  stop
else (no)
  |Publisher|
  :Return to Producer with reason;
  |Producer|
  :Reopen chapter;
  stop
endif
@enduml
