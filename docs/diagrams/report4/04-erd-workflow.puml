@startuml erd_workflow
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
hide circle
skinparam linetype ortho
entity series {
*id : uuid <<PK>>
}
entity chapters {
*id : uuid <<PK>>
}
entity panels {
*id : uuid <<PK>>
}
entity users {
*id : uuid <<PK>>
}
entity pipeline_definitions {
*id : uuid <<PK>>
--
series_id : uuid <<FK>>
}
entity pipeline_stages {
*id : uuid <<PK>>
--
pipeline_definition_id : uuid <<FK>>
required_role : int
is_approval_gate : bool
}
entity stage_transitions {
*id : uuid <<PK>>
--
from_stage_id : uuid <<FK>>
to_stage_id : uuid <<FK>>
}
entity assignments {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
pipeline_stage_id : uuid <<FK>>
assignee_user_id : uuid <<FK>>
depends_on_assignment_id : uuid <<FK>>
entity_type : int
target_entity_id : uuid
status : int
}
entity submissions {
*id : uuid <<PK>>
--
assignment_id : uuid <<FK>>
attempt_number : int
status : int
chapter_version : bigint
script_revision_ids : uuid[]
}
entity change_requests {
*id : uuid <<PK>>
--
assignment_id : uuid <<FK>>
submission_id : uuid <<FK>>
status : int
}
entity stage_progress {
*id : uuid <<PK>>
--
panel_id : uuid <<FK>>
pipeline_stage_id : uuid <<FK>>
status : int
}
entity chapter_reviews {
*id : uuid <<PK>>
--
chapter_id : uuid
action : int
}
entity consistency_findings {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
}
entity preview_links {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
}
entity preview_feedback {
*id : uuid <<PK>>
--
preview_link_id : uuid <<FK>>
}
series ||--o| pipeline_definitions
pipeline_definitions ||--o{ pipeline_stages
pipeline_definitions ||--o{ stage_transitions
chapters ||--o{ assignments
pipeline_stages ||--o{ assignments
users ||--o{ assignments
assignments |o--o{ assignments
assignments ||--o{ submissions
submissions ||--o{ change_requests
assignments ||--o{ change_requests
panels ||--o{ stage_progress
pipeline_stages ||--o{ stage_progress
chapters ||--o{ chapter_reviews
chapters ||--o{ consistency_findings
chapters ||--o{ preview_links
preview_links ||--o{ preview_feedback
@enduml
