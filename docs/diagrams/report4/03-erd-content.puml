@startuml erd_content
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
hide circle
skinparam linetype ortho
entity users {
*id : uuid <<PK>>
}
entity studio_workspaces {
*id : uuid <<PK>>
--
owner_id : uuid <<FK>>
}
entity workspace_members {
*id : uuid <<PK>>
--
workspace_id : uuid <<FK>>
user_id : uuid <<FK>>
role : int
status : int
}
entity series {
*id : uuid <<PK>>
--
workspace_id : uuid <<FK>>
pipeline_definition_id : uuid <<FK>>
title : text
}
entity series_members {
*id : uuid <<PK>>
--
series_id : uuid <<FK>>
user_id : uuid <<FK>>
role : int
}
entity series_bibles {
*id : uuid <<PK>>
--
series_id : uuid <<FK>>
}
entity bible_entries {
*id : uuid <<PK>>
--
series_bible_id : uuid <<FK>>
category : int
}
entity bible_entry_revisions {
*id : uuid <<PK>>
--
bible_entry_id : uuid <<FK>>
review_status : int
details_json : jsonb
}
entity chapters {
*id : uuid <<PK>>
--
series_id : uuid <<FK>>
status : int
is_script_frozen : bool
version_vector : bigint
}
entity scenes {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
}
entity pages {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
}
entity panels {
*id : uuid <<PK>>
--
page_id : uuid <<FK>>
scene_id : uuid <<FK>>
}
entity script_lines {
*id : uuid <<PK>>
--
scene_id : uuid <<FK>>
panel_id : uuid <<FK>>
speaker_character_id : uuid <<FK>>
narration_mode : int
}
entity script_line_bible_links {
*id : uuid <<PK>>
--
script_line_id : uuid <<FK>>
bible_entry_id : uuid <<FK>>
}
entity content_revisions {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
scene_id : uuid <<FK>>
version_number : int
previous_revision_id : uuid
content_hash : text
}
entity chapter_snapshots {
*id : uuid <<PK>>
--
chapter_id : uuid <<FK>>
}
users ||--o{ studio_workspaces
users ||--o{ workspace_members
studio_workspaces ||--o{ workspace_members
studio_workspaces ||--o{ series
series ||--o{ series_members
users ||--o{ series_members
series ||--|| series_bibles
series_bibles ||--o{ bible_entries
bible_entries ||--o{ bible_entry_revisions
series ||--o{ chapters
chapters ||--o{ scenes
chapters ||--o{ pages
pages ||--o{ panels
scenes ||--o{ panels
scenes ||--o{ script_lines
panels |o--o{ script_lines
bible_entries |o--o{ script_lines
script_lines ||--o{ script_line_bible_links
bible_entries ||--o{ script_line_bible_links
chapters ||--o{ content_revisions
chapters ||--o{ chapter_snapshots
@enduml
