@startuml seq_script_update
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
actor Writer as W
participant ScriptLinesController as C
participant MediatR as M
participant UpdateScriptLineCommandHandler as H
participant ScriptLineRules as R
database PanelForgeDbContext as DB
W -> C : PUT script line + expectedChapterVersion
C -> M : Send(UpdateScriptLineCommand)
M -> H : Handle
H -> R : AuthorizeAsync
R -> DB : load Chapter, member role
alt script frozen or version mismatch
  R --> H : Conflict
  H --> C : failure
  C --> W : 409 - reload and retry
else allowed
  H -> DB : update ScriptLine, add ContentRevision,\nIncrementVersion
  note right of H : [Planned v1.3] flag assignments of\naffected panels for impact review
  DB --> H : saved
  H --> C : ScriptLineDto
  C --> W : 200 OK
end
@enduml
