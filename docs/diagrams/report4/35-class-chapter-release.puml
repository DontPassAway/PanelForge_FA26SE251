@startuml class_chapter_release
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
class ChaptersController {
  +FreezeScript(chapterId)
  +Approve(chapterId)
  +Reopen(chapterId)
  +Publish(chapterId)
}
class ApproveChapterCommandHandler
class PublishChapterCommandHandler
class ReopenChapterCommandHandler
class ChapterReviewRules <<static>> {
  +MemberIdsAsync(role)
}
class Chapter {
  +Status : ChapterStatus
  +Approve()
  +Reopen()
  +Publish(at)
}
class ChapterReview {
  +Action : ChapterReviewAction
  +Reason : string
}
class ChapterSnapshot
ChaptersController ..> ApproveChapterCommandHandler
ChaptersController ..> PublishChapterCommandHandler
ChaptersController ..> ReopenChapterCommandHandler
ApproveChapterCommandHandler ..> Chapter
ApproveChapterCommandHandler ..> ChapterReviewRules
PublishChapterCommandHandler ..> ChapterSnapshot : creates
Chapter "1" *-- "*" ChapterReview
@enduml
