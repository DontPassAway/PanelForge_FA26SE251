@startuml wf04_script_change
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BackgroundColor white
|Writer|
start
:Need to change a frozen script;
:Request reopen with reason\n[Planned v1.3];
|Producer|
if (Accept schedule impact?) then (yes)
  :Unfreeze script;
  |Writer|
  :Edit script lines;
  :New ContentRevision saved,\nold revision kept;
  |System|
  :Find panels bound to changed lines\n[Planned v1.3];
  :Flag covering assignments for impact review\n[Planned v1.3];
  |Editor|
  if (Redraw needed?) then (yes)
    :Return work\n(stage back to ReworkRequired);
  else (no)
    :Clear impact review,\nkeep approved work;
  endif
else (no)
  |Producer|
  :Keep script frozen,\nreply with reason;
endif
stop
@enduml
