{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git",
        "ref": "v4.10.0"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets.json)",
      "Read(./**/firebase-key.json)"
    ]
  }
}
